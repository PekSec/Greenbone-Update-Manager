[Unit]
Description=Greenbone maintenance: @JOB_COMMAND@
Documentation=https://github.com/PekSec/Greenbone-Update-Manager
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=@RUN_USER@
Environment=GB_CONFIG_FILE=@CONFIG_FILE@
ExecStart=@SBIN_DIR@/greenbone-update.sh @JOB_COMMAND@
TimeoutStartSec=0
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
# Per-command timeouts are enforced by the maintenance engine. Do not kill an
# archive/migration at an arbitrary systemd timeout; incomplete work stays gated.
