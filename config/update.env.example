# Literal KEY=value only; this file is parsed, never executed. Mode 0600.
DOWNLOAD_DIR="@DATA_DIR@"
PROJECT="@PROJECT@"
BACKUP_DIR="@BACKUP_DIR@"
LOCK_FILE="@LOCK_FILE@"
LOG="@LOG_FILE@"
GMP_CREDENTIALS_FILE="@CONFIG_DIR@/gmp-credentials.json"
KEEP_BACKUPS="7"
# A count is not a capacity guarantee; see docs/production-readiness.md.
# Optional assertion: DockerRootDir AND every existing volume must be on this mount.
# Configure after mounting the data SSD and configuring Docker; no data is moved.
DATA_MOUNT=""
# Existing separate mounted disk/share directory; empty means local backup only.
BACKUP_COPY_DIR=""
# Strongly recommended for remote copies: exact findmnt TARGET and SOURCE.
# E.g. /mnt/greenbone-backup and backup-server:/exports/greenbone.
# Missing/unexpected mounts fail before downtime. Empty leaves identity unasserted.
BACKUP_COPY_MOUNT=""
BACKUP_COPY_SOURCE=""
# Streaming volume compression; images.tar stays uncompressed for Docker load.
# none (legacy compatible) or gzip. Space estimates never assume compression savings.
BACKUP_COMPRESSION="none"
HEALTH_TIMEOUT="3600"
COMMAND_TIMEOUT="1800"
# Client wait only; Docker stop always uses --timeout -1 (never timeout SIGKILL).
STOP_TIMEOUT="900"
# Total snapshot/verify/copy budget and total restore budget, in seconds.
BACKUP_TIMEOUT="21600"
RESTORE_TIMEOUT="21600"
# Per Docker image save/load budget; also bounded by the operation budget.
IMAGE_ARCHIVE_TIMEOUT="7200"
MIN_FREE_MB="15000"
# Extra operation estimates are added per filesystem, plus this percent and MIN_FREE_MB.
SPACE_MARGIN_PERCENT="20"
MAX_LOG_BYTES="20971520"
# UTC wall-clock window, e.g. 23:00-03:00. Disabled until explicitly configured.
AUTO_WINDOW_UTC=""
# Set to 1 only after external scan admission is blocked throughout this window.
# All task schedules must be detached; merely choosing a time does not block scans.
AUTO_WINDOW_ACK="0"
# Used only by version-check, never downloaded/applied by feed-update or upgrade.
COMPOSE_URL="https://greenbone.github.io/docs/latest/_static/compose.yaml"
# Metadata retained for migration. Change networking in reviewed Compose source.
NGINX_HOST="@NGINX_HOST@"
NGINX_HTTP_PORT="@NGINX_HTTP_PORT@"
