# greenbone-update (managed by install.sh)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=@CRON_MAILTO@
# Cron follows the host timezone; maintenance admission windows use UTC.
0 2 * * * @CRON_USER@ GB_CONFIG_FILE=@CONFIG_FILE@ @SBIN_DIR@/greenbone-update.sh backup
@CRON_SCHEDULE@ @CRON_USER@ GB_CONFIG_FILE=@CONFIG_FILE@ @SBIN_DIR@/greenbone-update.sh feed-update
0 5 * * 0 @CRON_USER@ GB_CONFIG_FILE=@CONFIG_FILE@ @SBIN_DIR@/greenbone-update.sh version-check
