# Literal KEY=value only; this file is parsed, never executed. Mode 0600.
DOWNLOAD_DIR="@DATA_DIR@"
PROJECT="@PROJECT@"
BACKUP_DIR="@BACKUP_DIR@"
LOCK_FILE="@LOCK_FILE@"
LOG="@LOG_FILE@"
GMP_CREDENTIALS_FILE="@CONFIG_DIR@/gmp-credentials.json"
KEEP_BACKUPS="7"
# Existing separate mounted disk/share directory; empty means local backup only.
BACKUP_COPY_DIR=""
HEALTH_TIMEOUT="3600"
COMMAND_TIMEOUT="1800"
MIN_FREE_MB="15000"
MAX_LOG_BYTES="20971520"
# UTC wall-clock window, e.g. 23:00-03:00. Disabled until explicitly configured.
AUTO_WINDOW_UTC=""
# Set to 1 only after external scan admission is blocked throughout this window.
# All task schedules must be detached; merely choosing a time does not block scans.
AUTO_WINDOW_ACK="0"
# Used only by version-check, never downloaded/applied by feed-update or upgrade.
COMPOSE_URL="https://greenbone.github.io/docs/latest/_static/compose.yaml"
# Metadata retained for migration. Change networking in reviewed Compose source.
NGINX_HOST="@NGINX_HOST@"
NGINX_HTTP_PORT="@NGINX_HTTP_PORT@"
