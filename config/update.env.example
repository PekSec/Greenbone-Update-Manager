# Greenbone update - runtime config
# Target: @CONFIG_FILE@   (mode 600, owner @RUN_USER@)
# Every environment-specific / sensitive value lives here, NOT in the script.

# --- required ---
DOWNLOAD_DIR="@DATA_DIR@"
PROJECT="@PROJECT@"
NGINX_HOST="@NGINX_HOST@"
NGINX_HTTP_PORT="@NGINX_HTTP_PORT@"

# --- paths ---
COMPOSE_FILE="@DATA_DIR@/compose.yaml"
BACKUP_DIR="@BACKUP_DIR@"
LOG="@LOG_FILE@"
LOCK_FILE="@LOCK_FILE@"
KEEP_BACKUPS="10"

# --- upstream ---
COMPOSE_URL="https://greenbone.github.io/docs/latest/_static/compose.yaml"
CURL_RETRY="3"

# --- tuning ---
MAX_IPS_PER_TARGET="66000"
NOFILE_LIMIT="65536"
NPROC_LIMIT="65535"

# --- health / safety ---
HEALTH_URL="http://127.0.0.1:@NGINX_HTTP_PORT@/"
HEALTH_TIMEOUT="600"
MIN_FREE_MB="15000"
STRICT_PATCH="1"          # 1: do not deploy if the patch cannot be validated

# --- maintenance ---
PRUNE_ENABLED="1"
PRUNE_UNTIL="168h"
MAX_LOG_BYTES="20971520"

# --- optional ---
# DOCKER_BIN="/usr/bin/docker"
